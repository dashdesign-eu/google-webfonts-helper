{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "sourceMap": true,
    "outDir": "./dist/server",
    "rootDir": "./server",
    "strict": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "types": [
      "node",
      "mocha"
    ]
  },
  "include": [
    "server/**/*.ts",
    "server/**/*.js",
    "server/**/*.json"
  ]
}
