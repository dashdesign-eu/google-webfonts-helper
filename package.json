{
  "name": "google-webfonts-helper",
  "version": "1.1.0",
  "homepage": "https://gwfh.mranftl.com",
  "main": "server/app.ts",
  "author": "majodev",
  "license": "MIT",
  "keywords": [
    "google fonts",
    "web fonts",
    "download",
    "woff",
    "svg",
    "ttf",
    "woff2",
    "eot",
    "css",
    "snippet",
    "hosting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/majodev/google-webfonts-helper.git"
  },
  "dependencies": {
    "axios": "1.20.0",
    "bluebird": "3.7.2",
    "compression": "1.8.2",
    "css": "3.0.0",
    "express": "4.22.3",
    "jszip": "3.10.2",
    "lodash": "4.18.1",
    "morgan": "1.12.1",
    "source-map-support": "0.5.21",
    "speakingurl": "14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/bluebird": "^3.5.38",
    "@types/compression": "^1.8.1",
    "@types/css": "^0.0.33",
    "@types/express": "^4.17.17",
    "@types/lodash": "^4.14.191",
    "@types/mocha": "^10.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "24",
    "@types/speakingurl": "^13.0.3",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "file-type": "22.2.0",
    "mocha": "12.0.3",
    "should": "13.2.3",
    "supertest": "7.3.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "node dist/server/app.js",
    "lint": "eslint server client/native scripts",
    "build": "node scripts/build.mjs",
    "test": "NODE_ENV=test mocha --timeout 30000 --exit \"dist/server/**/*.spec.js\"",
    "test:client": "node --test test/client/*.test.mjs",
    "test:browser": "playwright test",
    "dev": "npm run build && node --watch dist/server/app.js",
    "tsc": "tsc --noEmit --skipLibCheck"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "overrides": {
    "decode-uri-component": "0.5.1"
  }
}
